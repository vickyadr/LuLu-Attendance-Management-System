# Copy to .env and fill in the values for your environment.
# Values below are placeholders only - never commit a real .env.

# Required: Postgres connection string
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/DATABASE

# Required: secret used to hash passwords. The server refuses to start
# without it. Generate one with: openssl rand -hex 32
# Changing it later invalidates every stored password.
SECRET_KEY=replace-with-a-long-random-string

# Bind address (default 0.0.0.0:4343)
HOST=0.0.0.0
PORT=4343

# Comma-separated origins the API answers for, e.g.
#   ALLOWED_ORIGINS=https://lulu.example.com,https://admin.example.com
# Unset means loopback and private-range origins only, which covers a LAN or
# localhost install. Public origins are never accepted by default.
ALLOWED_ORIGINS=

# Log level (default info)
RUST_LOG=info
