# Created by install.sh; edit and rerun `docker compose up -d` after changes.

# Public address Caddy listens on.
#   :80                     plain HTTP on every interface (default)
#   lulu.example.com        automatic HTTPS via Let's Encrypt (DNS must point here)
#   https://192.168.1.1     HTTPS with a certificate; browsers must trust it
SITE_ADDRESS=:80

POSTGRES_DB=lulu
POSTGRES_USER=lulu
POSTGRES_PASSWORD=change-me

# 32 random bytes, hex. Rotating it revokes every session.
SECRET_KEY=change-me

# Created or refreshed on every API start. Changing the password here and
# restarting the API resets that account (all its sessions die).
ADMIN_NICKNAME=admin
ADMIN_PASSWORD=change-me
