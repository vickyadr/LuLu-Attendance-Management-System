{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run generate:demo",
  "outputDirectory": ".output/public",
  "framework": "nuxtjs",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [{ "source": "/((?!_nuxt/|favicon|robots).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/_nuxt/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}